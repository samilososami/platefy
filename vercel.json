{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.ts": {
      "includeFiles": "public/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "/settings/"
    },
    {
      "source": "/api/",
      "destination": "/settings/"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "/chatbot/",
      "permanent": true
    },
    {
      "source": "/app/",
      "destination": "/chatbot/",
      "permanent": true
    },
    {
      "source": "/app/:path*",
      "destination": "/chatbot/",
      "permanent": true
    },
    {
      "source": "/app/:path*/",
      "destination": "/chatbot/",
      "permanent": true
    },
    {
      "source": "/chatbot",
      "destination": "/restaurantes/",
      "permanent": false
    },
    {
      "source": "/chatbot/",
      "destination": "/restaurantes/",
      "permanent": false
    },
    {
      "source": "/menu/:path*",
      "destination": "/restaurantes/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/restaurantes/:slug/menu.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/menu/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
